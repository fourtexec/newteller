    <file>qml/NotificationCenter.qml</file>
    <file>qml/NotificationAppearance.qml</file>
    <file>qml/QuickSettingsPopup.qml</file>
    <file>themes/default.json</file>
    <file>themes/light.json</file>
    <file>themes/nord.json</file>
    <file>themes/highcontrast.json</file>
    <file>themes/ocean.json</file>
    <file>themes/sunrise.json</file>
  </qresource>
  <!-- The core icons (github.com/fourtexec/iconkit, lucide set, ISC licence):
       compiled into the binary so the shell chrome renders on any system,
       before IconKit on disk or the system icon theme are consulted. The
       prefix is "/" and the file paths start with icons/, so every icon sits
       at qrc:/icons/<name>.svg - exactly where Shell.iconUrl() looks. -->
  <qresource prefix="/">
    <file>icons/arrow-up.svg</file>
    <file>icons/app-window.svg</file>
    <file>icons/battery.svg</file>
    <file>icons/battery-charging.svg</file>
    <file>icons/bell.svg</file>
    <file>icons/bell-off.svg</file>
    <file>icons/bell-ring.svg</file>
    <file>icons/check.svg</file>
    <file>icons/chevron-left.svg</file>
    <file>icons/chevron-right.svg</file>
    <file>icons/clipboard.svg</file>
    <file>icons/cpu.svg</file>
    <file>icons/disc-3.svg</file>
    <file>icons/download.svg</file>
    <file>icons/eraser.svg</file>
    <file>icons/file-code.svg</file>
    <file>icons/file-text.svg</file>
    <file>icons/funnel.svg</file>
    <file>icons/folder.svg</file>
    <file>icons/house.svg</file>
    <file>icons/image.svg</file>
    <file>icons/info.svg</file>
    <file>icons/layout-grid.svg</file>
    <file>icons/lock.svg</file>
    <file>icons/log-out.svg</file>
