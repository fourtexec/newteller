<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  What the administrator prompt says when the updater (Settings, Updates)
  installs a build or goes back to the previous one. Without this file
  pkexec would only name the program it is asked to run as root.
-->
<policyconfig>
  <vendor>fourtexec</vendor>
  <vendor_url>https://fourtexec.site/newteller/</vendor_url>
  <action id="org.newteller.update.install">
    <description>Install a NewTeller update</description>
    <description xml:lang="ru">Установка обновления NewTeller</description>
    <message>The administrator password is needed to install a NewTeller build</message>
    <message xml:lang="ru">Чтобы установить сборку NewTeller, нужен пароль администратора</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/newteller-update-install</annotate>
  </action>
</policyconfig>
