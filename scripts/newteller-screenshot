#!/bin/sh
# Take a screenshot through the compositor's wlr-screencopy support.
#
#   newteller-screenshot          the whole screen (Print)
#   newteller-screenshot --area   a region picked with the mouse (Shift+Print,
#                                 Super+Shift+S); needs slurp
#
# The PNG goes to Screenshots in the pictures folder (~/Pictures) and, when wl-copy is installed, to
# the clipboard as well, ready to paste.
set -eu

mode=full
case "${1:-}" in
    --area|-a) mode=area ;;
    '' ) ;;
    *) echo "usage: newteller-screenshot [--area]" >&2; exit 2 ;;
esac

# The pictures folder is localized on many systems (~/Изображения): ask
# xdg-user-dir, or read user-dirs.dirs ourselves when it is not installed.
pictures="${XDG_PICTURES_DIR:-}"
if [ -z "$pictures" ] && command -v xdg-user-dir >/dev/null 2>&1; then
    pictures="$(xdg-user-dir PICTURES 2>/dev/null || true)"
    [ "$pictures" = "$HOME" ] && pictures=""
fi
if [ -z "$pictures" ]; then
    dirs="${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs"
    if [ -r "$dirs" ]; then
        pictures="$(sed -n 's/^XDG_PICTURES_DIR="\(.*\)"$/\1/p' "$dirs" | tail -n 1)"
        pictures="$(printf '%s' "$pictures" | sed "s|^\$HOME|$HOME|")"
    fi
fi
[ -n "$pictures" ] || pictures="$HOME/Pictures"
dir="$pictures/Screenshots"
mkdir -p "$dir"
file="$dir/Screenshot_$(date +%Y%m%d-%H%M%S)-$$.png"

notify() {
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session --dest org.newteller.Shell \
            --object-path /org/newteller/Shell \
            --method org.newteller.Shell.notify "$1" "$2" >/dev/null 2>&1 && return 0
    fi
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$1" "$2" >/dev/null 2>&1 && return 0
    fi
    printf '%s: %s\n' "$1" "$2" >&2
}

if ! command -v grim >/dev/null 2>&1; then
    notify "Screenshot failed" "grim is not installed"
    exit 1
fi

if [ "$mode" = area ]; then
    if ! command -v slurp >/dev/null 2>&1; then
        notify "Screenshot failed" "Area screenshots need slurp (sudo apt install slurp)"
        exit 1
    fi
    # Escape in slurp cancels: no screenshot, no error.
    region=$(slurp -d 2>/dev/null) || exit 0
    [ -n "$region" ] || exit 0
    grim -g "$region" "$file" || {
        notify "Screenshot failed" "The compositor did not return an image"
        exit 1
    }
elif ! grim "$file"; then
    notify "Screenshot failed" "The compositor did not return an image"
    exit 1
fi

if command -v wl-copy >/dev/null 2>&1; then
    wl-copy --type image/png < "$file" >/dev/null 2>&1 &
    notify "Screenshot saved" "$file (also copied to the clipboard)"
else
    notify "Screenshot saved" "$file"
fi
printf '%s\n' "$file"
