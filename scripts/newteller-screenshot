#!/bin/sh
# Take a screenshot through the compositor's wlr-screencopy support.
#
#   newteller-screenshot          the whole screen (Print)
#   newteller-screenshot --area   a region picked with the mouse (Shift+Print,
#                                 Super+Shift+S); needs slurp
#   newteller-screenshot --geometry "X,Y WxH"
#                                 that rectangle (Alt+Print: the focused
#                                 window, as the compositor knows it)
#
# The PNG goes to Screenshots in the pictures folder (~/Pictures) and, when wl-copy is installed, to
# the clipboard as well, ready to paste. shell.json can change that:
#   screenshot.folder      another folder ("~/Desktop"); empty: the default
#   screenshot.fileName    date(1) pattern of the name, "Screenshot_%Y%m%d-%H%M%S"
#   screenshot.saveFile    false: only the clipboard (needs wl-copy)
#   screenshot.clipboard   false: do not copy it
#   screenshot.cursor      true: draw the pointer too
#   screenshot.delay       seconds to wait before taking it (0-10)
set -eu

conf="${XDG_CONFIG_HOME:-$HOME/.config}/newteller/shell.json"
# setting KEY: the value of a top level key of shell.json (one key per line,
# as the shell writes it), without quotes; empty when it is not there.
setting() {
    key=$(printf '%s' "$1" | sed 's/\./\\./g')
    sed -n "s/^[[:space:]]*\"$key\"[[:space:]]*:[[:space:]]*\(.*\)\$/\1/p" "$conf" 2>/dev/null \
        | head -n 1 | sed 's/[[:space:]]*,[[:space:]]*$//; s/^"\(.*\)"$/\1/; s/\\"/"/g; s/\\\\/\\/g'
}

mode=full
geometry=
case "${1:-}" in
    --area|-a) mode=area ;;
    --geometry|-g)
        mode=geometry
        geometry="${2:-}"
        case "$geometry" in
            *,*\ *x*) ;;
            *) echo "usage: newteller-screenshot --geometry \"X,Y WxH\"" >&2; exit 2 ;;
        esac
        ;;
    '' ) ;;
    *) echo "usage: newteller-screenshot [--area | --geometry \"X,Y WxH\"]" >&2; exit 2 ;;
esac

# The pictures folder is localized on many systems (~/Изображения): ask
# xdg-user-dir, or read user-dirs.dirs ourselves when it is not installed.
pictures="${XDG_PICTURES_DIR:-}"
if [ -z "$pictures" ] && command -v xdg-user-dir >/dev/null 2>&1; then
    pictures="$(xdg-user-dir PICTURES 2>/dev/null || true)"
    [ "$pictures" = "$HOME" ] && pictures=""
fi
if [ -z "$pictures" ]; then
    dirs="${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs"
    if [ -r "$dirs" ]; then
        pictures="$(sed -n 's/^XDG_PICTURES_DIR="\(.*\)"$/\1/p' "$dirs" | tail -n 1)"
        pictures="$(printf '%s' "$pictures" | sed "s|^\$HOME|$HOME|")"
    fi
fi
[ -n "$pictures" ] || pictures="$HOME/Pictures"
dir="$pictures/Screenshots"
folder=$(setting screenshot.folder)
case "$folder" in
    '') ;;
    '~') dir="$HOME" ;;
    '~/'*) dir="$HOME/${folder#\~/}" ;;
    /*) dir="$folder" ;;
    *) dir="$HOME/$folder" ;;
esac

pattern=$(setting screenshot.fileName)
[ -n "$pattern" ] || pattern="Screenshot_%Y%m%d-%H%M%S"
# A pattern cannot reach another folder.
name=$(date +"$pattern" 2>/dev/null | tr '/' '-') || name=""
[ -n "$name" ] || name="Screenshot_$(date +%Y%m%d-%H%M%S)"

copy=yes
[ "$(setting screenshot.clipboard)" = false ] && copy=no
command -v wl-copy >/dev/null 2>&1 || copy=no
keep=yes
# Clipboard only: the picture lives in the runtime folder just long
# enough to be copied. Without a clipboard it is always kept.
[ "$(setting screenshot.saveFile)" = false ] && [ "$copy" = yes ] && keep=no
if [ "$keep" = no ]; then
    dir="${XDG_RUNTIME_DIR:-/tmp}"
fi
mkdir -p "$dir"
file="$dir/$name.png"
# Two shots within the same second (or a pattern without the time) do not
# overwrite each other.
[ ! -e "$file" ] || file="$dir/$name-$$.png"

cursor=
[ "$(setting screenshot.cursor)" = true ] && cursor=-c
delay=$(setting screenshot.delay | tr -cd '0-9')
[ -n "$delay" ] || delay=0
[ "$delay" -le 10 ] || delay=10

# Messages follow the shell's language (shell.language in shell.json),
# else the system locale.
language=$(sed -n 's/.*"shell\.language"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' \
    "${XDG_CONFIG_HOME:-$HOME/.config}/newteller/shell.json" 2>/dev/null | head -n 1)
case "$language" in
    ''|auto) language="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" ;;
esac
case "$language" in
    ru*)
        msg_failed="Не удалось сделать снимок экрана"
        msg_no_grim="grim не установлен"
        msg_no_slurp="Для снимка области нужен slurp (sudo apt install slurp)"
        msg_no_image="Композитор не вернул изображение"
        msg_saved="Снимок экрана сохранён"
        msg_copied="также скопирован в буфер обмена"
        msg_copied_only="Снимок экрана скопирован в буфер обмена"
        ;;
    *)
        msg_failed="Screenshot failed"
        msg_no_grim="grim is not installed"
        msg_no_slurp="Area screenshots need slurp (sudo apt install slurp)"
        msg_no_image="The compositor did not return an image"
        msg_saved="Screenshot saved"
        msg_copied="also copied to the clipboard"
        msg_copied_only="Screenshot copied to the clipboard"
        ;;
esac

# notify SUMMARY BODY [IMAGE]: the image becomes the notification's picture
# (image-path) where the daemon shows one.
notify() {
    if command -v gdbus >/dev/null 2>&1; then
        if [ -n "${3:-}" ]; then
            # GVariant text: quote the path, escaping \ and '.
            quoted=$(printf '%s' "$3" | sed "s/\\\\/\\\\\\\\/g; s/'/\\\\'/g")
            gdbus call --session --dest org.freedesktop.Notifications \
                --object-path /org/freedesktop/Notifications \
                --method org.freedesktop.Notifications.Notify \
                "Screenshot" 0 "image" "$1" "$2" "[]" "{'image-path': <'$quoted'>}" "int32 -1" \
                >/dev/null 2>&1 && return 0
        fi
        gdbus call --session --dest org.newteller.Shell \
            --object-path /org/newteller/Shell \
            --method org.newteller.Shell.notify "$1" "$2" >/dev/null 2>&1 && return 0
    fi
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$1" "$2" >/dev/null 2>&1 && return 0
    fi
    printf '%s: %s\n' "$1" "$2" >&2
}

if ! command -v grim >/dev/null 2>&1; then
    notify "$msg_failed" "$msg_no_grim"
    exit 1
fi

if [ "$mode" = area ]; then
    if ! command -v slurp >/dev/null 2>&1; then
        notify "$msg_failed" "$msg_no_slurp"
        exit 1
    fi
    # Escape in slurp cancels: no screenshot, no error.
    region=$(slurp -d 2>/dev/null) || exit 0
    [ -n "$region" ] || exit 0
    sleep "$delay"
    grim $cursor -g "$region" "$file" || {
        notify "$msg_failed" "$msg_no_image"
        exit 1
    }
elif [ "$mode" = geometry ]; then
    sleep "$delay"
    grim $cursor -g "$geometry" "$file" || {
        notify "$msg_failed" "$msg_no_image"
        exit 1
    }
else
    sleep "$delay"
    if ! grim $cursor "$file"; then
        notify "$msg_failed" "$msg_no_image"
        exit 1
    fi
fi

if [ "$keep" = no ]; then
    # wl-copy has read the picture once it returns; the file can go.
    wl-copy --type image/png < "$file" >/dev/null 2>&1 || true
    rm -f "$file"
    notify "$msg_copied_only" ""
    exit 0
fi
if [ "$copy" = yes ]; then
    wl-copy --type image/png < "$file" >/dev/null 2>&1 &
    notify "$msg_saved" "$file ($msg_copied)" "$file"
else
    notify "$msg_saved" "$file" "$file"
fi
printf '%s\n' "$file"
